[Unit]
Description=GStreamer NDI relay (preview-only, not broadcasting) for bcast-control web panel
After=network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target

[Service]
Type=simple
User=broadcast
Group=broadcast
EnvironmentFile=/opt/ndi-relay/relay.env
Environment=RELAY_DESTINATION=preview
Environment=RELAY_MODE=Broadcast
Environment=GST_PLUGIN_PATH=/opt/ndi-relay/gst-plugins
ExecStart=/opt/ndi-relay/bin/run-relay.sh
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
