[Unit]
Description=GStreamer NDI audio-level meter for bcast-control web panel
After=network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target

[Service]
Type=simple
User=broadcast
Group=broadcast
EnvironmentFile=/opt/ndi-relay/relay.env
Environment=GST_PLUGIN_PATH=/opt/ndi-relay/gst-plugins
ExecStart=/opt/ndi-relay/bin/audio-level-monitor.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
