# Copy this file to /opt/ndi-relay/relay.env (mode 600 -- it holds a real
# stream key) and fill in your own values.

# Camera's NDI video port, as IP:port -- NOT the discovered/advertised
# name. Connecting by direct IP:port bypasses NDI's normal multicast
# discovery, which some managed/enterprise WiFi (e.g. Meraki) blocks
# outright. Find your camera's NDI port by scanning for its NDI service
# announcement (commonly advertised on TCP 5960, with the actual video
# stream on a nearby port like 5961) -- e.g. `nmap -p 5960 <your-subnet>`,
# or check your camera vendor's NDI documentation.
NDI_URL_ADDRESS=192.168.1.100:5961

# RTMP ingest server + your real stream key from YouTube Studio's
# "Stream key" page. Treat this file like a password once filled in.
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=your-stream-key-here

VIDEO_BITRATE_KBPS=4500
AUDIO_BITRATE_BPS=128000
